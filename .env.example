# ---- 本機開發不需要設定任何東西，直接 npm start 也能跑 ----
# ---- 以下是要「部署上線」或「接 Telegram/Google 登入」時才需要 ----

# Turso 雲端資料庫（部署上線才需要；本機開發不設定的話會自動用本機檔案 data/finance.db）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Telegram 機器人
# 1. 到 Telegram 搜尋 @BotFather，傳送 /newbot，依指示取得 Token
TELEGRAM_BOT_TOKEN=
# 2. 白名單：先留空啟動，跟機器人說一句話，它會回傳你的 Chat ID，複製貼到這裡再重啟
TELEGRAM_ALLOWED_CHAT_ID=
# 3. 只有「正式部署到雲端」才需要這個（本機開發用 polling，留空即可）
#    設定成你部署後的網址，例如 https://your-app.onrender.com
TELEGRAM_WEBHOOK_URL=

# Google 登入（保護網頁儀表板）
# 到 https://console.cloud.google.com/apis/credentials 建立 OAuth 用戶端 ID（類型：網頁應用程式）
GOOGLE_CLIENT_ID=
# 只允許這個 Gmail 帳號登入看到資料
ALLOWED_GOOGLE_EMAIL=

# 自訂一組長亂數字串，用來簽署登入用的 cookie（隨便打一長串英數字即可）
JWT_SECRET=

# 每週定時報告：另一組長亂數字串，外部 cron（GitHub Actions）呼叫時要帶這組密鑰
# 同一組值要設定兩個地方：Render 的環境變數，以及 GitHub repo 的 Actions secret
CRON_SECRET=

PORT=3000
